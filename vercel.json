{
  "version": 2,
  "routes": [
    {
      "src": "/(.*)",
      "methods": ["OPTIONS"],
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PUT, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization"
      },
      "dest": "/api/health.js"
    },
    { "src": "/api/auth/cashier", "dest": "/api/auth/cashier.js" },
    { "src": "/api/auth/waiter", "dest": "/api/auth/waiter.js" },
    { "src": "/api/orders/finalize", "dest": "/api/orders/finalize.js" },
    { "src": "/api/orders/alerts", "dest": "/api/orders/alerts.js" },
    { "src": "/api/orders/([^/]+)", "dest": "/api/orders/[id].js" },
    { "src": "/api/orders", "dest": "/api/orders/index.js" },
    { "src": "/api/telegram", "dest": "/api/telegram/index.js" },
    { "src": "/health", "dest": "/api/health.js" }
  ]
}
